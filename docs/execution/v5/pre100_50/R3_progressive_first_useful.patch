+    #: How many sources the first wave may fetch. Small on purpose: this is
+    #: the set that decides how long a reader waits, and every document added
+    #: here is added to that wait for every company.
+    FIRST_USEFUL_SOURCES = 3
+
+    @staticmethod
+    def _first_useful_candidates(approved, candidates):
+        """The smallest approved set that can carry a defensible reading.
+
+        The subject's OWN primary filing and its OWN front page: identity,
+        what it sells, how it earns and what it says about its own position
+        all come from those two. Third-party corroboration deepens a reading
+        and cannot establish one, so it belongs in the second wave.
+
+        Returns () when the split would not help -- there is nothing to gain
+        from a first wave that is the whole approved set.
+        """
+        by_id = {c["candidate_id"]: c for c in candidates or ()}
+
+        def _is_filing(c):
+            # The regulator's copy of the subject's own annual report. Matched
+            # on the HOST rather than on `source_type`, whose vocabulary
+            # (homepage/product/pricing/about/...) has no name for a filing.
+            return "sec.gov" in str(c.get("url") or c.get("canonical_url")
+                                    or "").lower()
+
+        def _is_front_page(c):
+            return str(c.get("source_type") or "") in ("homepage", "about")
+
+        chosen = []
+        for test in (_is_filing, _is_front_page):
+            for cid in approved or ():
+                candidate = by_id.get(cid) or {}
+                if cid not in chosen and test(candidate):
+                    chosen.append(cid)
+                    break
+        if not chosen:
+            chosen = list(approved or ())[:1]
+        return tuple(chosen[:WebApp.FIRST_USEFUL_SOURCES])
+
+    def _compose_first_useful(self, run_id: str) -> bool:
+        """Publish an early bounded reading. Never fails the run.
+
+        A failure here means the first wave was not enough to compose from,
+        which is not an error: the second wave is already on its way and the
+        final composition is unchanged. Swallowing it is correct precisely
+        because this is an OPTIMISATION of when the reader is let in, not a
+        step the analysis depends on.
+        """
+        try:
+            early = self._compose(run_id)
+        except Exception as exc:                # noqa: BLE001 - see docstring
+            _LOG.info("first-useful composition skipped run=%s %s: %s",
+                      run_id, type(exc).__name__, str(exc)[:120])
+            return False
+        if not early:
+            return False
+        self._results[run_id] = early
+        return True
+
